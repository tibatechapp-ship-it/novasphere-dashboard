# ============================================
# Raqib — Environment Configuration
# ============================================

# ---- Runtime ----
ENV=development
MOCK_DATA=true

# ---- Database ----
# Dev (SQLite):
DATABASE_URL=sqlite:///./raqib.db
# Prod (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://raqib:raqib_secret@postgres:5432/raqib_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---- Smart Runbooks ----
REMEDIATION_PLATFORM_URL=
RUNBOOKS_DIR=

# ============================================
# PRODUCTION ONLY — required for docker-compose.prod.yml
# ============================================
POSTGRES_PASSWORD=change_me_in_production
REDIS_PASSWORD=change_me_in_production
GRAFANA_ADMIN_PASSWORD=change_me_in_production